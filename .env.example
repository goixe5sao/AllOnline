# AllOnline — environment template. Copy to .env.local (never commit real values).
#
# Leave DATABASE_URL empty to run in DEMO MODE: local PGlite database in ./.data,
# demo sign-in, fake payment button. Demo mode is clearly labelled in the UI and
# refuses to start under NODE_ENV=production unless ALLOW_DEMO_MODE=1.

# --- Supabase project dedicated to AllOnline (NOT the goixe5sao.vn project) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string (server only — secret). Supabase → Connect → Session pooler.
DATABASE_URL=
# Optional, server only: enables uploads to Supabase Storage (bucket below, private).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=allonline-uploads

# --- Server ---
# Random 32+ byte secret for signing WebSocket tickets / room passes. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
PORT=3000
# Set to 1 ONLY when running behind the host's reverse proxy, so per-IP limits use X-Forwarded-For.
# Leave empty for direct connections (otherwise clients could spoof their IP).
TRUST_PROXY=
# Public URL used in sign-up confirmation emails, e.g. https://allonline-test.example.com
PUBLIC_ORIGIN=

# --- Payments (optional) ---
# Shared secret for the generic HMAC-signed webhook POST /api/payments/webhook.
# Empty = webhook disabled; orders are approved manually by the app owner.
PAYMENT_WEBHOOK_SECRET=
